---
import { onMount } from 'solid-js';
---

<section id="stats" class="bg-gray-50 py-16">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <h2 style="font-family: 'Nunito', sans-serif; font-weight: 900; color: #1f2937;" 
        class="text-3xl md:text-5xl font-bold mb-4">
      Nuestra Experiencia en Rehabilitación
    </h2>
    <p style="color: #4B5563;" class="mb-12 text-lg md:text-xl">
      Más de 1,000 pacientes recuperados gracias a nuestros tratamientos personalizados y profesionales.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      <div class="stat-card p-6 bg-white rounded-lg shadow-lg">
        <span style="color: #3b82f6;" class="text-5xl font-bold">+</span>
        <span style="color: #3b82f6;" class="text-5xl font-bold counter" data-target="1500">0</span>
        <p style="color: #6B7280;" class="mt-2 font-medium">Pacientes Recuperados</p>
      </div>
      <div class="stat-card p-6 bg-white rounded-lg shadow-lg">
        <span style="color: #3b82f6;" class="text-5xl font-bold counter" data-target="10">0</span>
        <p style="color: #6B7280;" class="mt-2 font-medium">Profesionales Especializados</p>
      </div>
      <div class="stat-card p-6 bg-white rounded-lg shadow-lg">
        <span style="color: #3b82f6;" class="text-5xl font-bold">+</span>
        <span style="color: #3b82f6;" class="text-5xl font-bold counter" data-target="2000">0</span>
        <p style="color: #6B7280;" class="mt-2 font-medium">Sesiones Completadas</p>
      </div>
    </div>
  </div>

  <script type="module">
    // Contador animado al hacer scroll
    const counters = document.querySelectorAll('.counter');
    let started = false;

    function animateCounter(el, target) {
      let current = 0;
      const increment = Math.ceil(target / 200); // Ajusta la velocidad
      const interval = setInterval(() => {
        current += increment;
        if (current >= target) {
          el.textContent = target;
          clearInterval(interval);
        } else {
          el.textContent = current;
        }
      }, 10);
    }

    function handleScroll() {
      const section = document.getElementById('stats');
      const rect = section.getBoundingClientRect();
      if (!started && rect.top < window.innerHeight) {
        counters.forEach(counter => {
          const target = parseInt(counter.getAttribute('data-target'));
          animateCounter(counter, target);
        });
        started = true;
      }
    }

    window.addEventListener('scroll', handleScroll);
    handleScroll(); // Por si ya está visible al cargar
  </script>
</section>
