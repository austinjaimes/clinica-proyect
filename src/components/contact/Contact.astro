---
import Divider from "@/components/divider/Divider.astro";
import ContactForm from "@/components/forms/ContactForm.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getLocalizedRoute, getTranslatedData, useTranslations } from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const t = useTranslations(currLocale);
---

<section id="contact" class="site-container my-20 scroll-mt-20 md:my-32">
	<div class="mt-6 grid gap-10 lg:grid-cols-2">
		<div>
			<h2 class="h1 text-primary">Agenda tu Cita</h2>
			<p class="text-muted-foreground mt-4 mb-8 text-lg">
				Estamos aquí para ayudarte con todas tus necesidades médicas. No dudes en solicitar una cita o hacernos una pregunta.
			</p>

			<div class="mb-8">
				<h3 class="font-heading mb-4 text-xl leading-normal font-bold">Horario de Atención</h3>
				<p class="text-muted-foreground">Lunes - Viernes: 8:00 AM - 6:00 PM</p>
				<p class="text-muted-foreground">Sábado: 9:00 AM - 1:00 PM</p>
				<p class="text-muted-foreground">Domingo: Cerrado</p>
			</div>

			<div class="mb-8">
				<h3 class="font-heading mb-4 text-xl leading-normal font-bold">Información de Contacto</h3>
				<p class="text-muted-foreground mb-2">
					<span class="font-semibold">Teléfono:</span>
					+52 1 733 139 7477
				</p>
				<p class="text-muted-foreground mb-2">
					<span class="font-semibold">Correo electrónico:</span>
					<a
						class="text-foreground hover:text-primary underline hover:no-underline"
						href={getLocalizedRoute(currLocale, `mailto:rehabilitasport@gmail.com`)}
					>rehabilitasport@gmail.com</a>
				</p>
			</div>

			<div class="mb-8">
				<h3 class="font-heading mb-4 text-xl leading-normal font-bold">Nuestra Ubicación</h3>
				<div class="w-full rounded-lg overflow-hidden shadow-lg aspect-video">
					<iframe
						title="Ubicación de Rehabilita Sport en Google Maps"
						src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d812.4000392052193!2d-99.5320757!3d18.3431358!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85cc386f9ac86a9b%3A0x32fce6d1b9324e3d!2sRehabilita%20Sport!5e1!3m2!1ses-419!2smx!4v1748478320755!5m2!1ses-419!2smx"
						width="100%"
						height="100%"
						style="border:0;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>
		</div>

		<div>
			<div class="bg-primary-100/80 rounded-xl p-8 shadow-md">
				<h3 class="font-heading tracking-px-n mb-6 text-3xl leading-tight font-bold">
					Envíanos un Mensaje
				</h3>
				<ContactForm />
			</div>
		</div>
	</div>
</section>
