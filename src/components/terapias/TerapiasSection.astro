---
import img1 from "../../assets/camaraimg.jpg";
import img2 from "../../assets/laserimg.jpg";
import img3 from "../../assets/luzrojaimg.jpg";
import img4 from "../../assets/magnoterapiaimg.jpg";
---

<style>
  section {
    background-color: #f9fafb;
    padding: 5rem 1rem;
    font-family: 'Nunito', sans-serif;
    position: relative;
  }

  .section-title {
    text-align: center;
    margin-bottom: 3rem;
  }

  .grid-gallery {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    max-width: 1200px;
    margin: 0 auto;
  }

  .card {
    background: white;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid #e5e7eb;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    cursor: pointer;
  }

  .card:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
  }

  .card img {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover img {
    transform: scale(1.05);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox img {
    max-width: 90%;
    max-height: 80%;
    border-radius: 1rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }

  .close-btn {
    position: absolute;
    top: 30px;
    right: 40px;
    background: rgba(255,255,255,0.9);
    border: none;
    color: #111827;
    font-size: 1.5rem;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
  }

  .close-btn:hover {
    background: #3b82f6;
    color: white;
  }
</style>

<section id="galeria-imgs">
  <h2 style="font-family: 'Nunito', sans-serif; font-weight: 900; color: #1f2937;" class="text-3xl md:text-5xl font-bold section-title">Beneficios de Terapias</h2>

  <div class="grid-gallery">
    <div class="card">
      <img src={img1.src} alt="Imagen 1" class="gallery-img" />
    </div>

    <div class="card">
      <img src={img2.src} alt="Imagen 2" class="gallery-img" />
    </div>

    <div class="card">
      <img src={img3.src} alt="Imagen 3" class="gallery-img" />
    </div>

    <div class="card">
      <img src={img4.src} alt="Imagen 4" class="gallery-img" />
    </div>
  </div>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox">
    <img id="lightboxImg" src="" alt="Vista ampliada" />
  </div>

  <script>
    const images = document.querySelectorAll('.gallery-img');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImg');

    images.forEach(img => {
      img.addEventListener('click', () => {
        lightbox.classList.add('active');
        lightboxImg.src = img.src;
      });
    });

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        lightbox.classList.remove('active');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        lightbox.classList.remove('active');
      }
    });
  </script>
</section>
