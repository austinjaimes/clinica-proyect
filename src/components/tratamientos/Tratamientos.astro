---
import imgRehabilitacionIntervencionista from "/public/images/rehabilitacion-intervencionista.jpg"
import imgRehabilitacionDeportiva from "/public/images/rehabilitacion-deportiva.png"
import imgCirugiaColumna from "/public/images/cirugia-de-columna-2.jpg"
import imgMedicinaRegenerativa from "/public/images/medicina-regenerativa.jpg"
import imgMedicinaRegenerativaNew from "/public/images/medicina-regenerativanew.jpg"
---

<style>
  .carousel-container {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
  }

  .carousel {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    scroll-behavior: smooth;
  }

  /* .carousel::-webkit-scrollbar {
    display: none;
  } */

  .carousel::-webkit-scrollbar {
  height: 8px;
}

.carousel::-webkit-scrollbar-thumb {
  background-color: #555;
  border-radius: 4px;
}

.carousel::-webkit-scrollbar-track {
  background-color: #1e1e1e;
}

  .card {
  min-width: 260px;
  width: 260px; /* fija el ancho igual al min-width */
  max-width: 260px; /* opcional */
  height: 460px;
  background: #1e1e1e;
  color: white;
  border-radius: 1rem;
  padding: 1rem;
  flex-shrink: 0;
  scroll-snap-align: start;
  transition: transform 0.3s ease;
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  justify-content: space-between;
  overflow-wrap: break-word; /* para que las palabras largas se rompan */
}


  .card:hover {
    transform: scale(1.05);
  }

  .card img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 0.75rem;
    margin-bottom: 2rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .card-text {
  font-size: 0.95rem;
  color: #ccc;
  flex-grow: 1;
  overflow-wrap: break-word;
  word-wrap: break-word;
  hyphens: auto; /* opcional, para mejor separación de palabras */
}


  .btn-read-more {
    background-color: #3b82f6;
    color: white;
    border: none;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.3s ease;
    font-size: 0.9rem;
  }

  .btn-read-more:hover {
    background-color: #2563eb;
  }

  /* Flechas */
  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(30, 30, 30, 0.8);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.3s ease;
    box-shadow: 0 4px 8px rgba(0,0,0,0.4);
    z-index: 10;
  }

  .arrow:hover {
    background: #3b82f6;
  }

  .arrow svg {
    fill: white;
    width: 20px;
    height: 20px;
  }

  .arrow-left {
    left: 0.5rem;
  }

  .arrow-right {
    right: 0.5rem;
  }

  @media (min-width: 768px) {
    .carousel {
      padding-inline: 2rem;
    }
  }
</style>

<section id="tratamientos-section" class="px-6 py-20 bg-neutral-900 text-white scroll-mt-16">
  <div class="max-w-6xl mx-auto text-center mb-12">
    <h2 style="font-family: 'Nunito', sans-serif; font-weight: 900;  color: #ffffff;" class="text-3xl md:text-5xl font-bold">Nuestros Tratamientos</h2>
  </div>

  <div class="carousel-container max-w-6xl mx-auto">
    <div class="carousel" id="carousel">

      <!-- carta 1 -->
      <div class="card">
        <img src={imgRehabilitacionIntervencionista.src} alt="Rehabilitación Intervencionista" />
        <div style="font-family: 'Nunito', sans-serif;" class="card-title">Rehabilitación Intervencionista</div>
        <div style="font-family: 'Nunito', sans-serif;" class="card-text">Tratamientos precisos para el dolor y la movilidad</div>
        <button onclick="window.location.href='/tratamientos/rehabilitacion-intervencionista'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 2 -->
      <div class="card">
        <img src={imgRehabilitacionDeportiva.src} alt="Rehabilitación deportiva" />
        <div style="font-family: 'Nunito', sans-serif;" class="card-title">Rehabilitación deportiva</div>
        <div style="font-family: 'Nunito', sans-serif;" class="card-text">Recuperación y prevención de lesiones en deportistas.</div>
        <button onclick="window.location.href='/tratamientos/rehabilitacion-deportiva'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 3 -->
      <div class="card">
        <img src={imgCirugiaColumna.src} alt="Cirugía de columna vertebral" />
        <div style="font-family: 'Nunito', sans-serif;" class="card-title">Cirugía de columna vertebral</div>
        <div style="font-family: 'Nunito', sans-serif;" class="card-text">Cirugía para aliviar dolor y tratar trastornos estructurales de la columna.</div>
        <button onclick="window.location.href='/tratamientos/cirugia-de-columna-vertebral'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 4 -->
       <div class="card">
        <img src={imgMedicinaRegenerativaNew.src} alt="Medicina regenerativa" />
        <div style="font-family: 'Nunito', sans-serif;" class="card-title">Medicina regenerativa</div>
        <div style="font-family: 'Nunito', sans-serif;" class="card-text">Regenera, repara y recupera.</div>
        <button onclick="window.location.href='/tratamientos/medicina-regenerativa'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 5 -->
      <div class="card">
        <img src="https://fisiofix.pe/wp-content/uploads/2024/07/laser-en-fisioterapia.webp" alt="Láser de alta intensidad" />
        <div style="font-family: 'Nunito', sans-serif;" class="card-title">Láser de alta intensidad</div>
        <div style="font-family: 'Nunito', sans-serif;" class="card-text">Láser terapéutico que alivia el dolor.</div>
        <button onclick="window.location.href='/tratamientos/laser-de-alta-intensidad'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 6 -->
      <div class="card">
        <img src="https://clinicamedicaarboledas.com/wp-content/uploads/2023/06/camara-hiperbarica-jpg.webp" alt="Cámara Hiperbárica" />
        <div style="font-family: 'Nunito', sans-serif;" class="card-title">Cámara Hiperbárica</div>
        <div style="font-family: 'Nunito', sans-serif;" class="card-text">Oxígeno puro a alta presión para sanar más rápido.</div>
        <button onclick="window.location.href='/tratamientos/camara-hiperbarica'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 7 -->
      <div class="card">
        <img src="https://staticnew-prod.topdoctors.mx/files/Image/large/da333d698989f8cbd0fb855873e19952.png" alt="Protesis de cadera y rodilla" />
        <div style="font-family: 'Nunito', sans-serif;" class="card-title">Protesis de cadera y rodilla</div>
        <div style="font-family: 'Nunito', sans-serif;" class="card-text">Reemplazo articular para aliviar dolor y mejorar la movilidad.</div>
        <button onclick="window.location.href='/tratamientos/protesis-de-cadera-y-rodilla'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 8 -->
       <div class="card">
        <img src="https://staticnew-prod.topdoctors.cl/files/Image/large/0640cb68f1b75939a771a9a1cb97fc01.jpg" alt="Diagnóstico por imágenes" />
        <div style="font-family: 'Nunito', sans-serif;" class="card-title">Diagnóstico por imágenes</div>
        <div style="font-family: 'Nunito', sans-serif;" class="card-text">Imágenes del cuerpo para detectar, evaluar y guiar tratamientos médicos.</div>
        <button onclick="window.location.href='/tratamientos/diagnostico-por-imagenes'" class="btn-read-more">Leer más</button>
      </div>
      
      
    </div>
  </div>
</section>


