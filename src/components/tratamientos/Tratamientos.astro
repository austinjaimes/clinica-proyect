---
import imgRehabilitacionIntervencionista from "/public/images/rehabilitacion-intervencionista.jpg";
import imgRehabilitacionDeportiva from "/public/images/rehabilitacion-deportiva.webp";
import imgCirugiaColumna from "/public/images/cirugia-de-columna-2.jpg";
import imgMedicinaRegenerativaNew from "/public/images/medicina-regenerativanew.webp";
import imgDiagnosticoPorImagenes from "/public/images/diagnostico-por-imagenes.webp";
import imgProtesisDeCaderaYRodilla from "/public/images/protesis-de-cadera-y-rodilla.webp";
---

<style>
  .carousel-container {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
  }

  .carousel {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    scroll-behavior: smooth;
  }

  .carousel::-webkit-scrollbar {
    height: 8px;
  }

  .carousel::-webkit-scrollbar-thumb {
    background-color: #9ca3af; /* gris oscuro */
    border-radius: 4px;
  }

  .carousel::-webkit-scrollbar-track {
    background-color: #e5e7eb; /* gris claro */
  }

  .card {
    min-width: 260px;
    width: 260px;
    max-width: 260px;
    height: 460px;
    background: #ffffff; /* color claro */
    color: #111827; /* texto oscuro */
    border-radius: 1rem;
    padding: 1rem;
    flex-shrink: 0;
    scroll-snap-align: start;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 8px 16px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: space-between;
    overflow-wrap: break-word;
  }

  .card:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 24px rgba(0,0,0,0.2);
  }

  .card img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 0.75rem;
    margin-bottom: 2rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .card-text {
    font-size: 0.95rem;
    color: #4B5563;
    flex-grow: 1;
    overflow-wrap: break-word;
  }

  .btn-read-more {
    background-color: #3b82f6;
    color: white;
    border: none;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.3s ease;
    font-size: 0.9rem;
  }

  .btn-read-more:hover {
    background-color: #2563eb;
  }

  /* Flechas */
  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.8);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.3s ease;
    box-shadow: 0 4px 8px rgba(0,0,0,0.4);
    z-index: 10;
  }

  .arrow:hover {
    background: #3b82f6;
  }

  .arrow svg {
    fill: #111827;
    width: 20px;
    height: 20px;
  }

  .arrow-left {
    left: 0.5rem;
  }

  .arrow-right {
    right: 0.5rem;
  }

  @media (min-width: 768px) {
    .carousel {
      padding-inline: 2rem;
    }
  }
</style>

<section id="tratamientos-section" class="px-6 py-20 bg-gray-50 text-gray-900 scroll-mt-16">
  <div class="max-w-6xl mx-auto text-center mb-12">
    <h2 style="font-family: 'Nunito', sans-serif; font-weight: 900; color: #1f2937;" 
        class="text-3xl md:text-5xl font-bold">Nuestros Tratamientos</h2>
  </div>

  <div class="carousel-container max-w-6xl mx-auto">
    <div class="carousel" id="carousel">

      <!-- carta 1 -->
      <div class="card">
        <img src={imgRehabilitacionIntervencionista.src} alt="Rehabilitación Intervencionista" />
        <div style="font-family: 'Nunito', sans-serif; font-weight: 700; color: #111827;" class="card-title">Rehabilitación Intervencionista</div>
        <div style="font-family: 'Nunito', sans-serif; font-weight: 400; color: #4B5563;" class="card-text">
          Tratamientos precisos para el dolor y la movilidad
        </div>
        <button onclick="window.location.href='/tratamientos/rehabilitacion-intervencionista'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 2 -->
      <div class="card">
        <img src={imgRehabilitacionDeportiva.src} alt="Rehabilitación deportiva" />
        <div style="font-family: 'Nunito', sans-serif; font-weight: 700; color: #111827;" class="card-title">Rehabilitación deportiva</div>
        <div style="font-family: 'Nunito', sans-serif; font-weight: 400; color: #4B5563;" class="card-text">
          Recuperación y prevención de lesiones en deportistas.
        </div>
        <button onclick="window.location.href='/tratamientos/rehabilitacion-deportiva'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 3 -->
      <div class="card">
        <img src={imgCirugiaColumna.src} alt="Cirugía de columna vertebral" />
        <div style="font-family: 'Nunito', sans-serif; font-weight: 700; color: #111827;" class="card-title">Cirugía de columna vertebral</div>
        <div style="font-family: 'Nunito', sans-serif; font-weight: 400; color: #4B5563;" class="card-text">
          Cirugía para aliviar dolor y tratar trastornos estructurales de la columna.
        </div>
        <button onclick="window.location.href='/tratamientos/cirugia-de-columna-vertebral'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 4 -->
      <div class="card">
        <img src={imgMedicinaRegenerativaNew.src} alt="Medicina regenerativa" />
        <div style="font-family: 'Nunito', sans-serif; font-weight: 700; color: #111827;" class="card-title">Medicina regenerativa</div>
        <div style="font-family: 'Nunito', sans-serif; font-weight: 400; color: #4B5563;" class="card-text">
          Regenera, repara y recupera.
        </div>
        <button onclick="window.location.href='/tratamientos/medicina-regenerativa'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 5 -->
      <div class="card">
        <img src="https://fisiofix.pe/wp-content/uploads/2024/07/laser-en-fisioterapia.webp" alt="Láser de alta intensidad" />
        <div style="font-family: 'Nunito', sans-serif; font-weight: 700; color: #111827;" class="card-title">Láser de alta intensidad</div>
        <div style="font-family: 'Nunito', sans-serif; font-weight: 400; color: #4B5563;" class="card-text">
          Láser terapéutico que alivia el dolor.
        </div>
        <button onclick="window.location.href='/tratamientos/laser-de-alta-intensidad'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 6 -->
      <div class="card">
        <img src="https://clinicamedicaarboledas.com/wp-content/uploads/2023/06/camara-hiperbarica-jpg.webp" alt="Cámara Hiperbárica" />
        <div style="font-family: 'Nunito', sans-serif; font-weight: 700; color: #111827;" class="card-title">Cámara Hiperbárica</div>
        <div style="font-family: 'Nunito', sans-serif; font-weight: 400; color: #4B5563;" class="card-text">
          Oxígeno puro a alta presión para sanar más rápido.
        </div>
        <button onclick="window.location.href='/tratamientos/camara-hiperbarica'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 7 -->
      <div class="card">
        <img src={imgProtesisDeCaderaYRodilla.src} alt="Protesis de cadera y rodilla" />
        <div style="font-family: 'Nunito', sans-serif; font-weight: 700; color: #111827;" class="card-title">Protesis de cadera y rodilla</div>
        <div style="font-family: 'Nunito', sans-serif; font-weight: 400; color: #4B5563;" class="card-text">
          Reemplazo articular para aliviar dolor y mejorar la movilidad.
        </div>
        <button onclick="window.location.href='/tratamientos/protesis-de-cadera-y-rodilla'" class="btn-read-more">Leer más</button>
      </div>

      <!-- carta 8 -->
      <div class="card">
        <img src={imgDiagnosticoPorImagenes.src} alt="Diagnóstico por imágenes" />
        <div style="font-family: 'Nunito', sans-serif; font-weight: 700; color: #111827;" class="card-title">Diagnóstico por imágenes</div>
        <div style="font-family: 'Nunito', sans-serif; font-weight: 400; color: #4B5563;" class="card-text">
          Imágenes del cuerpo para detectar, evaluar y guiar tratamientos médicos.
        </div>
        <button onclick="window.location.href='/tratamientos/diagnostico-por-imagenes'" class="btn-read-more">Leer más</button>
      </div>

    </div>
  </div>
</section>
